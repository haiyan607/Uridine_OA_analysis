# ==========================================================
# Raw and processed data
#
# Keep README files so that the expected folder structure
# remains visible in the repository.
# ==========================================================

data/raw/*
!data/raw/README.md

data/processed/*
!data/processed/README.md

# Keep the metadata folder available for small public tables
# such as sample metadata.
# ==========================================================

# ==========================================================
# Large local output files
#
# Small result tables and selected preview figures may still
# be committed manually when needed.
# ==========================================================

results/figures/*.tif
results/figures/*.tiff
results/figures/*.pdf

